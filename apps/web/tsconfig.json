{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@talkie/types": ["../../packages/types/src"],
      "@talkie/types/*": ["../../packages/types/src/*"],
      "@talkie/auth": ["../../packages/auth/src"],
      "@talkie/auth/*": ["../../packages/auth/src/*"],
      "@talkie/config": ["../../packages/config/src"],
      "@talkie/config/*": ["../../packages/config/src/*"],
      "@talkie/ui": ["../../packages/ui/src"],
      "@talkie/ui/*": ["../../packages/ui/src/*"],
      "@talkie/database": ["../../packages/database/src"],
      "@talkie/database/*": ["../../packages/database/src/*"],
      "@talkie/telephony": ["../../packages/telephony/src"],
      "@talkie/telephony/*": ["../../packages/telephony/src/*"],
      "@talkie/voice": ["../../packages/voice/src"],
      "@talkie/voice/*": ["../../packages/voice/src/*"],
      "@talkie/webhook-engine": ["../../packages/webhook-engine/src"],
      "@talkie/webhook-engine/*": ["../../packages/webhook-engine/src/*"],
      "@talkie/billing": ["../../packages/billing/src"],
      "@talkie/billing/*": ["../../packages/billing/src/*"],
      "@talkie/sdk": ["../../packages/sdk-js/src"],
      "@talkie/sdk/*": ["../../packages/sdk-js/src/*"],
      "@talkie/mcp-server": ["../../packages/mcp-server/src"],
      "@talkie/mcp-server/*": ["../../packages/mcp-server/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
