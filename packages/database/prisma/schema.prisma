// Talkie Master Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String            @id @default(cuid())
  email         String            @unique
  name          String?
  passwordHash  String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  memberships   WorkspaceMember[]
  auditLogs     AuditLog[]

  @@map("users")
}

model Workspace {
  id            String            @id @default(cuid())
  name          String
  slug          String            @unique
  balanceCents  Int               @default(5000) // $50.00 starting demo balance
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  members       WorkspaceMember[]
  apiKeys       ApiKey[]
  agents        Agent[]
  phoneNumbers  PhoneNumber[]
  calls         Call[]
  conversations Conversation[]
  contacts      Contact[]
  webhooks      Webhook[]
  usageRecords  UsageRecord[]
  auditLogs     AuditLog[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        String    @default("member") // owner | admin | developer | member
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@map("workspace_members")
}

model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  keyHash     String    @unique
  keyHint     String    // e.g., tk_live_...abcd
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("api_keys")
}

model Agent {
  id                      String         @id @default(cuid())
  workspaceId             String
  name                    String
  description             String?
  voiceMode               String         @default("hosted") // hosted | webhook
  webhookUrl              String?
  systemPrompt            String         @default("You are a helpful AI phone agent.")
  beginMessage            String?        @default("Hello! How can I assist you today?")
  voice                   String         @default("aura-asteria-en")
  language                String         @default("en-US")
  voiceSpeed              Float          @default(1.0)
  interruptionSensitivity Float          @default(0.5)
  enableBackchannel       Boolean        @default(true)
  denoisingMode           String         @default("standard")
  maxSilenceMs            Int            @default(2000)
  status                  String         @default("active")
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  workspace               Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  phoneNumbers            PhoneNumber[]
  calls                   Call[]
  conversations           Conversation[]

  @@index([workspaceId])
  @@map("agents")
}

model PhoneNumber {
  id               String         @id @default(cuid())
  workspaceId      String
  agentId          String?
  provider         String         @default("mock") // mock | twilio | telnyx
  providerNumberId String?
  phoneNumber      String         @unique // E.164 format: +14155550142
  country          String         @default("US")
  countryCode      String         @default("+1")
  areaCode         String         @default("415")
  capabilitiesJson String         @default("{\"voice\":true,\"sms\":true,\"mms\":false}")
  status           String         @default("active") // available | provisioning | active | released | error
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  workspace        Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent            Agent?         @relation(fields: [agentId], references: [id], onDelete: SetNull)
  calls            Call[]
  conversations    Conversation[]

  @@index([workspaceId])
  @@index([agentId])
  @@index([phoneNumber])
  @@map("phone_numbers")
}

model Call {
  id              String       @id @default(cuid())
  workspaceId     String
  agentId         String?
  phoneNumberId   String?
  providerCallId  String?
  direction       String       // inbound | outbound
  fromNumber      String
  toNumber        String
  status          String       @default("queued") // queued | ringing | in_progress | completed | failed | busy | no_answer | cancelled
  durationSeconds Int          @default(0)
  startedAt       DateTime?
  endedAt         DateTime?
  summary         String?
  recordingUrl    String?
  transcriptStatus String      @default("pending") // pending | completed | error
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  workspace       Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent           Agent?       @relation(fields: [agentId], references: [id], onDelete: SetNull)
  phoneNumber     PhoneNumber? @relation(fields: [phoneNumberId], references: [id], onDelete: SetNull)
  transcripts     Transcript[]

  @@index([workspaceId])
  @@index([agentId])
  @@index([phoneNumberId])
  @@index([providerCallId])
  @@index([createdAt])
  @@map("calls")
}

model Transcript {
  id          String   @id @default(cuid())
  callId      String
  speaker     String   // user | agent | system
  text        String
  timestampMs Int      @default(0)
  confidence  Float    @default(0.95)
  createdAt   DateTime @default(now())

  call        Call     @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId])
  @@map("transcripts")
}

model Conversation {
  id               String    @id @default(cuid())
  workspaceId      String
  agentId          String?
  phoneNumberId    String?
  contactId        String?
  channel          String    @default("sms") // sms | mms | imessage | whatsapp
  externalThreadId String?
  lastMessageAt    DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent            Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
  phoneNumber      PhoneNumber? @relation(fields: [phoneNumberId], references: [id], onDelete: SetNull)
  contact          Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  messages         Message[]

  @@index([workspaceId])
  @@index([phoneNumberId])
  @@index([contactId])
  @@index([lastMessageAt])
  @@map("conversations")
}

model Message {
  id                String       @id @default(cuid())
  conversationId    String
  providerMessageId String?
  direction         String       // inbound | outbound
  senderNumber      String
  recipientNumber   String
  body              String
  mediaJson         String?      @default("[]")
  status            String       @default("sent") // queued | sending | sent | delivered | failed
  sentAt            DateTime     @default(now())
  createdAt         DateTime     @default(now())

  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([providerMessageId])
  @@index([createdAt])
  @@map("messages")
}

model Contact {
  id            String         @id @default(cuid())
  workspaceId   String
  name          String
  phoneNumber   String
  email         String?
  company       String?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([workspaceId])
  @@index([phoneNumber])
  @@map("contacts")
}

model Webhook {
  id             String            @id @default(cuid())
  workspaceId    String
  url            String
  secret         String
  status         String            @default("active") // active | paused | disabled
  eventsJson     String            @default("[\"*\"]")
  lastDeliveryAt DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries     WebhookDelivery[]

  @@index([workspaceId])
  @@map("webhooks")
}

model WebhookDelivery {
  id             String   @id @default(cuid())
  webhookId      String
  event          String
  payloadJson    String
  statusCode     Int?
  responseBody   String?
  latencyMs      Int?
  attempt        Int      @default(1)
  status         String   @default("success") // success | retrying | failed
  nextRetryAt    DateTime?
  createdAt      DateTime @default(now())

  webhook        Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([createdAt])
  @@map("webhook_deliveries")
}

model UsageRecord {
  id           String    @id @default(cuid())
  workspaceId  String
  type         String    // phone_number | sms | mms | voice_minute | tts_character | stt_minute | llm_token | webhook_delivery
  quantity     Int
  unit         String
  costCents    Int       @default(0)
  metadataJson String?
  timestamp    DateTime  @default(now())

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([type])
  @@index([timestamp])
  @@map("usage_records")
}

model AuditLog {
  id           String    @id @default(cuid())
  workspaceId  String
  userId       String?
  action       String    // user.login | agent.created | number.provisioned ...
  resourceType String
  resourceId   String?
  metadataJson String?
  ip           String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model IdempotencyRecord {
  id           String    @id @default(cuid())
  key          String    @unique
  workspaceId  String
  endpoint     String
  responseCode Int
  responseBody String
  createdAt    DateTime  @default(now())
  expiresAt    DateTime

  @@index([key])
  @@index([workspaceId])
  @@index([expiresAt])
  @@map("idempotency_records")
}
