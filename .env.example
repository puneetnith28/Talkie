# ==========================================
# Talkie — Environment Configuration
# ==========================================

# Runtime Mode
NODE_ENV=development
DEMO_MODE=true

# URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:3000/api

# Database & Caching
DATABASE_URL="postgresql://talkie:talkie_secret@localhost:5432/talkiedb?schema=public"
REDIS_URL="redis://localhost:6379"

# Authentication
AUTH_SECRET="talkie_development_auth_secret_32chars_long_minimum"
JWT_EXPIRES_IN="7d"

# Telephony Provider (mock | twilio | telnyx)
TELEPHONY_PROVIDER=mock
TELEPHONY_ACCOUNT_ID=
TELEPHONY_AUTH_TOKEN=
TELEPHONY_WEBHOOK_SECRET=

# AI Voice Engine (mock | hosted | webhook)
VOICE_AI_PROVIDER=mock
LLM_PROVIDER=mock
LLM_API_KEY=
STT_PROVIDER=mock
STT_API_KEY=
TTS_PROVIDER=mock
TTS_API_KEY=

# Billing (mock | stripe)
BILLING_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Webhook Delivery Settings
WEBHOOK_MAX_RETRIES=5
WEBHOOK_TIMEOUT_MS=10000
